# Copy to .env and set the absolute path to your Obsidian plugin folder.
# When set, `npm run dev` and `npm run build` will copy main.js, manifest.json,
# and styles.css here on every successful build.
OBSIDIAN_PLUGIN_DIR=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault/.obsidian/plugins/obsidian-tasks-timeline
