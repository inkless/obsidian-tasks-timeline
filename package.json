		"builtin-modules": "^5.1.0",
		"esbuild": "^0.25.12",
		"esbuild-svelte": "^0.8.2",
		"eslint": "^9.39.4",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^15.15.0",
		"obsidian": "^1.12.3",
		"svelte": "^4.2.20",
		"svelte-eslint-parser": "^1.6.0",
		"svelte-preprocess": "^5.1.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1"
	}
